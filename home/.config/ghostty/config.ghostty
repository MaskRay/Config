# Ghostty reads $XDG_CONFIG_HOME/ghostty/config.ghostty; a file named `config`
# is ignored.
font-family = Adwaita Mono

# CJK fallback. SC carries the whole pan-CJK repertoire.
font-family = Source Han Sans SC

font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Match the Tokyo Night background used by neovim.
#
# Zellij leaves the continuation cell of double-width CJK glyphs unpainted when it
# repaints a pane from its internal grid (e.g. on tab switch), so those cells fall
# through to Ghostty's default background (#282c34) and show up as grey blocks in
# CJK-heavy buffers. Matching the two makes the unpainted cells invisible.
#
# This is a cosmetic mask, not a fix -- the bug is upstream in zellij. A pane resize
# forces a full repaint and clears the blocks for real.
background = 1a1b26

# Optional: uncomment to render slightly bolder if it still looks thin.
# font-thicken = true

keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
